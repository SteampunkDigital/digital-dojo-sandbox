# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=digital_dojo

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# SD3.5 Configuration (path to your sd3.5 repo)
SD35_REPO_PATH=/path/to/sd3.5
SD35_MODEL=sd3.5_medium.safetensors

# SAM3D Configuration (path to your sam-3d-objects repo)
SAM3D_REPO_PATH=/path/to/sam-3d-objects

# Output Format: splat (Gaussian splat .ply) or mesh (GLB mesh)
OUTPUT_FORMAT=splat

# Embedding Model Configuration
# EMBEDDING_MODEL: openclip (default) or flair
EMBEDDING_MODEL=openclip

# OpenCLIP settings (when EMBEDDING_MODEL=openclip)
CLIP_MODEL=ViT-L-14
CLIP_PRETRAINED=laion2b_s32b_b82k

# FLAIR settings (when EMBEDDING_MODEL=flair)
# Model from: https://github.com/ExplainableML/flair
FLAIR_MODEL=xiaorui638/flair
# Optional: path to cloned FLAIR repo for full functionality
# FLAIR_REPO_PATH=/path/to/flair

# Library Generation
LIBRARY_VARIANTS_PER_ITEM=3

# Flask Configuration
FLASK_DEBUG=true
FLASK_PORT=5000
